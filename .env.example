# Pooled connection string — used by every request handler.
# On Neon/Vercel Postgres this is the host containing "-pooler".
POSTGRES_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require"

# Direct/unpooled connection — MIGRATIONS ONLY. Never imported by a handler.
POSTGRES_URL_UNPOOLED="postgresql://user:pass@host.region.aws.neon.tech/db?sslmode=require"

# Anything prefixed VITE_ is shipped to the browser. Never put a secret here.
VITE_API_BASE_URL="/api"
